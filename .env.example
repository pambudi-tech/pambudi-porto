# The PIN pass for password-protected work (server/works-pass.mjs). Copy to
# .env.local for the dev server, and set the same names on Vercel.
WORKS_PIN=000000
WORKS_SECRET=a-long-random-string-of-at-least-16-characters
# Dev server only: 1 forgets the pass on every project page load, so each
# refresh shows the PIN panel. Never set it on Vercel; it has no effect there.
WORKS_RESET_PASS=0
