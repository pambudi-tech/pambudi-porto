{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && mv dist/index.html dist/home.html",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "card.pambudi.xyz" }],
      "destination": "/card.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "wax.pambudi.xyz" }],
      "destination": "/seal.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/work/:id",
      "destination": "/home.html"
    }
  ],
  "redirects": [
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ocean.html",
      "destination": "/work/ocean",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "missing": [{ "type": "query", "key": "v" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "has": [{ "type": "query", "key": "v" }],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/gallery.js": {
      "includeFiles": "private/**"
    },
    "api/work-asset.js": {
      "includeFiles": "private/**"
    }
  }
}
